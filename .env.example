# ============================================================
# CẤU HÌNH MÔI TRƯỜNG - PHÒNG KHÁM ĐA KHOA AN PHÚC
# Sao chép file này thành .env và điền thông tin thật của bạn.
# KHÔNG BAO GIỜ commit file .env lên Git!
# ============================================================

# Cổng chạy server
PORT=3000
NODE_ENV=development

# Tên miền thật của website (dùng cho sitemap.xml, canonical & Open Graph SEO)
SITE_URL=https://phongkhamanphuc.vn

# Khóa bí mật ký JWT (bắt buộc đổi sang chuỗi ngẫu nhiên dài >= 32 ký tự trên production)
JWT_SECRET=thay-doi-chuoi-bi-mat-nay-bang-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=12h

# Tài khoản Admin mặc định (chỉ dùng khi bảng users chưa có dữ liệu)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 1) Cloud PostgreSQL (Neon / Supabase / Render...) — Ưu tiên số 1
# Để trống nếu muốn chạy bằng SQL Server nội bộ hoặc JSON fallback
DATABASE_URL=

# 2) Microsoft SQL Server nội bộ — Ưu tiên số 2 (nếu không đặt DATABASE_URL)
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=PhongKhamAnPhuc
DB_USER=
DB_PASSWORD=

# 3) Đặt DB_MODE=fallback để ép chạy bằng db_fallback_data.json (hữu ích khi test/offline)
# DB_MODE=fallback
